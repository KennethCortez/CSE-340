<!DOCTYPE html>
<html lang="en">
    
<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/navigation") %>
<body>
    <img src="/images/site/small_check.jpg" alt="checknerboard pattern" class="bg-pattern">

    <main>
        <h1><%= title %></h1>

        <% if (!appointments || appointments.length === 0) { %>

            <p>You don't have active appointmens.</p>
            <a href="/appointments/new" class="btn">Create an appointment</a>

        <% } else { %>

        <% appointments.forEach(appt => { %>

            <div class="card">
                <p><strong>Date:</strong> <%= appt.appointment_date %></p>
                <p><strong>Status:</strong> <%= appt.status %></p>
                <p><strong>Description:</strong> <%= appt.description %></p>
            </div>

        <% }) %>

        <% } %>


    </main>
</body>
<%- include("../partials/footer") %>
</html>