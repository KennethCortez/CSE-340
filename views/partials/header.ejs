<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>
    <div id="tools">
        <% if (locals.loggedin) { %>
            <!-- Logged in: Welcome + Logout -->
            <a href="/account/" title="Go to your account">
                Welcome <%= locals.accountData.account_firstname %>
            </a>

            <a href="/account/logout" title="Click to log out">
                Logout
            </a>

        <% } else { %>
            <!-- Not logged in: Show My Account -->
            <a title="Click to log in" href="/account/login">My account</a>
        <% } %>
    </div>
</header>
