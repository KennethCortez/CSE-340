<!DOCTYPE html>
<html lang="en">

    <%- include("../partials/head") %>

<body>
    <%- include("../partials/header") %>
    <%- include("../partials/navigation") %>

    <img src="/images/site/small_check.jpg" alt="checknerboard pattern" class="bg-pattern">

    <main>
        <h1>Account Management</h1>

        <% if (accountData) { %>

            <% if (accountData.account_type === "Client") { %>
                <h2>Welcome <%= accountData.account_firstname %></h2>
            <% } else { %>
                <h2>Welcome <%= accountData.account_firstname %></h2>
                <h3>Inventory Management</h3>
                <p><a href="/inv/">Go to Inventory Management</a></p>
            <% } %>

            <p><a href="/account/update/<%= accountData.account_id %>">Update Account Information</a></p>

        <% } else { %>

            <p>You are not logged in.</p>

        <% } %>

        <li><a href="/account/logout">Logout</a></li>

    </main>

    <%- include("../partials/footer") %>
</body>
</html>
    