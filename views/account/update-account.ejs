<!DOCTYPE html>
<html lang="en">

<%- include("../partials/head") %>

<body>
    <%- include("../partials/header") %>
    <%- include("../partials/navigation") %>

    <img src="/images/site/small_check.jpg" alt="checknerboard pattern" class="bg-pattern">

    <main>
        <h1><%= title %></h1>

        <!-- Flash Messages -->
        <% if (messages && messages.length > 0) { %>
            <div class="notice">
                <% messages.forEach(msg => { %>
                    <p><%= msg %></p>
                <% }) %>
            </div>
        <% } %>

        <!-- Validation Errors -->
        <% if (errors && errors.length > 0) { %>
            <div class="errors">
                <% errors.forEach(err => { %>
                    <p><%= err.msg %></p>
                <% }) %>
            </div>
        <% } %>

        <!-- ========================= -->
        <!--   ACCOUNT UPDATE FORM     -->
        <!-- ========================= -->

        <h2>Update Account Information</h2>

        <form action="/account/update" method="POST" class="account-update-form">

            <label for="account_firstname">First Name</label>
            <input type="text" id="account_firstname" name="account_firstname" required
                value="<%= accountData ? accountData.account_firstname : '' %>">

            <label for="account_lastname">Last Name</label>
            <input type="text" id="account_lastname" name="account_lastname" required
                value="<%= accountData ? accountData.account_lastname : '' %>">

            <label for="account_email">Email</label>
            <input type="email" id="account_email" name="account_email" required
                value="<%= accountData ? accountData.account_email : '' %>">

            <!-- Hidden ID -->
            <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

            <button type="submit">Update Information</button>
        </form>


        <!-- ========================= -->
        <!--   CHANGE PASSWORD FORM    -->
        <!-- ========================= -->

        <h2>Change Password</h2>
        <p>Enter a new password below. This will replace your current password.</p>
        <p>Password must be at least 12 characters and contain a combination of uppercase, lowercase, numbers and symbols.</p>

        <form action="/account/update-password" method="POST" class="password-change-form">

            <label for="account_password">New Password</label>
            <input type="password" id="account_password" name="account_password" required>

            <!-- Hidden ID -->
            <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

            <button type="submit">Change Password</button>
        </form>

    </main>

    <%- include("../partials/footer") %>
</body>
</html>
